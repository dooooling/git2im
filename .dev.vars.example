# ==============================================================================
# 本地开发环境变量模版 (.dev.vars.example)
#
# 使用方式：
# 1. 复制本文件并重命名为 `.dev.vars`：`cp .dev.vars.example .dev.vars`
# 2. 修改其中的密钥值
# 3. 注意：`.dev.vars` 包含敏感密钥，已在 .gitignore 中忽略，严禁提交到 Git 仓库！
# ==============================================================================

# 管理后台初始登录密码（本地开发使用）
ADMIN_PASSWORD=admin-password-for-local-dev-123456

# AES-256-GCM 主密钥（Base64 编码的 32 字节 / 256 位随机密钥）
# 生成命令示例 (Node.js):
#   node -e "console.log(crypto.randomBytes(32).toString('base64'))"
MASTER_KEY=k8x+N3Z9nLq1sR7uV2wY5zB8cD0eF3gH6jK9mP2rT5v=

# 可选：指定网关版本号（用于调试与诊断）
VERSION=1.0.0-dev
